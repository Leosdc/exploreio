{
  "name": "exploreio",
  "version": "0.3.0",
  "description": "A Yazi-inspired terminal file explorer with native rich in-prompt file preview & reader for Markdown, interactive JSON, HTML, and syntax-highlighted code.",
  "type": "module",
  "bin": {
    "exploreio": "./dist/cli.js",
    "exp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "keywords": [
    "cli",
    "tui",
    "file-manager",
    "yazi",
    "markdown",
    "json",
    "html",
    "syntax-highlighting",
    "terminal"
  ],
  "author": "Leonardo da Cruz (@Leosdc)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leosdc/exploreio.git"
  },
  "homepage": "https://github.com/Leosdc/exploreio#readme",
  "bugs": {
    "url": "https://github.com/Leosdc/exploreio/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
