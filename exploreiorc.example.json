{
  "theme": "midnight",
  "keybinds": {
    "global": {
      "quit": ["q"],
      "help": ["?"],
      "openKeybinds": ["K", "ctrl+k"],
      "cycleTheme": ["t"]
    },
    "browser": {
      "moveUp": ["up", "k"],
      "moveDown": ["down", "j"],
      "pageUp": ["pageup"],
      "pageDown": ["pagedown"],
      "goTop": ["home", "g"],
      "goBottom": ["end", "G"],
      "open": ["enter", "right", "l"],
      "parentDir": ["left", "backspace", "h"],
      "filter": ["/", "f"],
      "toggleHidden": ["."],
      "createEntry": ["a"],
      "renameEntry": ["r"],
      "deleteEntry": ["d"],
      "copyPath": ["y"],
      "openEditor": ["e"],
      "openFullscreen": ["o", "F"],
      "openGitPanel": ["tab", "ctrl+g"],
      "refresh": ["R"]
    },
    "reader": {
      "back": ["escape", "q", "backspace"],
      "moveUp": ["up", "k"],
      "moveDown": ["down", "j"],
      "pageUp": ["pageup", "b"],
      "pageDown": ["pagedown", "space"],
      "goTop": ["home", "g"],
      "goBottom": ["end", "G"],
      "toggleMode": ["tab"],
      "search": ["/"],
      "searchNext": ["n"],
      "searchPrev": ["N"],
      "copyPath": ["y"],
      "openEditor": ["e", "E"],
      "openFullscreen": ["o", "F"],
      "openGitPanel": ["ctrl+g"],
      "jsonToggleNode": ["enter", "space"],
      "jsonExpandNode": ["right", "l"],
      "jsonCollapseNode": ["left", "h"],
      "jsonExpandAll": ["e"],
      "jsonCollapseAll": ["c"]
    },
    "git": {
      "back": ["escape", "q"],
      "nextTab": ["tab"],
      "prevTab": ["shift+tab"],
      "moveUp": ["up", "k"],
      "moveDown": ["down", "j"],
      "detailUp": ["pageup", "K"],
      "detailDown": ["pagedown", "J"],
      "stageToggle": ["s", "space"],
      "stageAll": ["S"],
      "unstageAll": ["U"],
      "commit": ["c"],
      "pull": ["p"],
      "push": ["P"],
      "fetch": ["f"],
      "createBranch": ["b"],
      "stashPush": ["z"],
      "stashPop": ["Z"],
      "discard": ["x"],
      "copyItem": ["y"],
      "openItem": ["enter"],
      "quickPalette": ["?"],
      "refresh": ["r"]
    }
  }
}
